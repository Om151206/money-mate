# Copy this file to .env and set your real MySQL credentials.
# The database itself must already exist. Money Mate creates its tables on startup.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=money_mate
DB_PASSWORD=replace-with-a-strong-password
DB_NAME=money_mate
SESSION_SECRET=replace-with-a-long-random-secret

# Alternative: supply a complete MySQL URL instead of DB_HOST through DB_NAME.
# DATABASE_URL=mysql://money_mate:password@127.0.0.1:3306/money_mate

# Set true when your managed MySQL provider requires TLS.
# MYSQL_SSL=true
